---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import GalleryNarratives from '../components/GalleryNarratives.astro';
import { localPath } from '../lib/site';
import { galleryThemes } from '../data/gallery';
---
<BaseLayout title="Galeria">
  <PageIntro eyebrow="REGISTROS & ENCONTROS" title="Memórias em imagens." description="Momentos, encontros e caminhos percorridos ao longo do projeto." />
  <section class="section">
    <div class="container gallery-page">
      {galleryThemes.map((theme) => (
        <article class="gallery-theme" id={theme.id}>
          <div class="gallery-header">
            <div>
              <p class="eyebrow"><span aria-hidden="true">✳</span> MEMÓRIA VISUAL</p>
              <h2>{theme.title}</h2>
            </div>
            {theme.description && <p class="gallery-description">{theme.description}</p>}
          </div>
          <div class="gallery-grid">
            {theme.images.map((item) => (
              <figure class="gallery-card">
                <a href={item.image.src} aria-label={`Abrir imagem: ${item.alt}`}>
                  <Image src={item.image} alt={item.alt} width={Math.min(item.image.width, 800)} format="webp" loading="lazy" />
                </a>
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
          {theme.hasNarrative && <GalleryNarratives category={theme.title} />}
        </article>
      ))}
    </div>
  </section>
  <section class="section section-tint">
    <div class="container editorial-grid">
      <div><p class="eyebrow"><span aria-hidden="true">✳</span> REGISTROS</p><h2>Memórias que continuam <em>vivas.</em></h2></div>
      <div class="prose">
        <p>As imagens da galeria registram rodas de conversa, caminho de pesquisa, encontros no território e histórias de mulheres ancestrais que vivem no centro do projeto.</p>
        <p>Para conhecer o conjunto visual do mural produzido na comunidade, siga para o registro do mural ancestral.</p>
        <a class="text-link" href={localPath('/resultados/mural-ancestral/')}>Ver o mural ancestral <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
