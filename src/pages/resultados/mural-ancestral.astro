---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { muralPhotos } from '../../data/mural';

const photos = await Promise.all(muralPhotos.map(async (photo) => ({
  ...photo,
  large: await getImage({ src: photo.image, width: Math.min(photo.image.width, 1600), format: 'webp' }),
})));
---
<BaseLayout title="Mural ancestral">
  <PageIntro eyebrow="RESULTADOS / MURAL ANCESTRAL" title="Saberes que colorem o território." description="Uma expressão coletiva dos conhecimentos e das histórias que fazem parte da comunidade da Piedade." />
  <section class="section">
    <div class="container editorial-grid">
      <div><p class="eyebrow"><span aria-hidden="true">✳</span> ARTE & MEMÓRIA</p><h2>Uma história pintada a <em>muitas mãos.</em></h2></div>
      <div class="prose">
        <p>Para popularizar os resultados da pesquisa, foi desenvolvido um mural na entrada da comunidade Piedade, em Vitória (ES). A obra apresenta os saberes das lavadeiras, parteiras, benzedeiras e mulheres do samba.</p>
        <p>A pintura integrou o projeto de extensão “Colorindo os saberes femininos ancestrais da Piedade e da Fonte Grande”, proposto pelo Ifes – campus Vitória, e foi coordenada pela professora de artes Jéssica Galon da Silva Macedo. Participaram da ação a tutora do projeto, os pesquisadores juniores e estudantes do Ifes.</p>
      </div>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container">
      <div class="section-header"><div><p class="eyebrow"><span aria-hidden="true">✳</span> REGISTROS</p><h2>O mural em <em>imagens.</em></h2></div><p>Selecione uma imagem para vê-la ampliada.</p></div>
      <div class="photo-grid">
        {photos.map((photo) => (
          <figure>
            <a href={photo.large.src} aria-label={`Ampliar imagem: ${photo.alt}`}>
              <Image src={photo.image} alt={photo.alt} width={600} format="webp" loading="lazy" />
            </a>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <dialog class="lightbox" aria-label="Visualizador de imagens do mural" aria-describedby="lightbox-caption">
    <div class="lightbox-content">
      <div class="lightbox-header">
        <p>REGISTROS DO MURAL ANCESTRAL</p>
        <button class="lightbox-button lightbox-close" type="button" aria-label="Fechar visualizador" autofocus><span aria-hidden="true">×</span></button>
      </div>
      <div class="lightbox-stage">
        <button class="lightbox-button lightbox-previous" type="button" aria-label="Imagem anterior"><span aria-hidden="true">‹</span></button>
        <img class="lightbox-image" alt="" />
        <button class="lightbox-button lightbox-next" type="button" aria-label="Próxima imagem"><span aria-hidden="true">›</span></button>
      </div>
      <p class="lightbox-caption" id="lightbox-caption" aria-live="polite" aria-atomic="true"></p>
    </div>
  </dialog>
  <script>
    const dialog = document.querySelector('.lightbox');
    const image = document.querySelector('.lightbox-image');
    const caption = document.querySelector('.lightbox-caption');
    const previous = document.querySelector('.lightbox-previous');
    const next = document.querySelector('.lightbox-next');
    const close = document.querySelector('.lightbox-close');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.photo-grid a'));

    if (dialog instanceof HTMLDialogElement && typeof dialog.showModal === 'function' &&
        image instanceof HTMLImageElement && caption && previous && next && close && links.length) {
      const viewerImage = image;
      const viewerCaption = caption;
      let current = 0;
      let opener: HTMLAnchorElement | undefined;

      function showImage(index: number) {
        current = (index + links.length) % links.length;
        const link = links[current];
        const thumbnail = link.querySelector('img');
        if (!thumbnail) throw new Error('Imagem da galeria não encontrada.');
        viewerImage.src = link.href;
        viewerImage.alt = thumbnail.alt;
        viewerCaption.textContent = `Imagem ${current + 1} de ${links.length}. ${thumbnail.alt}`;
      }

      links.forEach((link, index) => {
        link.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          opener = link;
          showImage(index);
          dialog.showModal();
          document.body.classList.add('lightbox-open');
          event.preventDefault();
        });
      });

      previous.addEventListener('click', () => showImage(current - 1));
      next.addEventListener('click', () => showImage(current + 1));
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          dialog.close();
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          showImage(current + (event.key === 'ArrowLeft' ? -1 : 1));
        }
      });
      dialog.addEventListener('close', () => {
        document.body.classList.remove('lightbox-open');
        opener?.focus();
      });
    }
  </script>
</BaseLayout>
