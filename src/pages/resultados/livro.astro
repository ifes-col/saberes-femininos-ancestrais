---
import { Image } from 'astro:assets';
import bookCover from '../../assets/book/capa-livro.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { bookUrl } from '../../lib/site';
---
<BaseLayout title="Livro">
  <PageIntro eyebrow="RESULTADOS / LIVRO" title="Uma memória que se compartilha." description="Um convite a conhecer histórias e saberes que permanecem vivos no território." />
  <section class="section">
    <div class="container book-layout">
      <div class="book-display"><Image src={bookCover} alt="Capa do livro Saberes Femininos Ancestrais, com duas mulheres diante de uma paisagem." width={650} format="webp" /></div>
      <div class="prose">
        <p class="eyebrow"><span aria-hidden="true">✳</span> SABERES FEMININOS ANCESTRAIS</p>
        <h2>Histórias que <em>atravessam gerações.</em></h2>
        <p>O livro reúne histórias de mulheres que fizeram das comunidades da Piedade e da Fonte Grande lugares de cuidado, acolhimento, sabedoria e coletividade.</p>
        <p>Organização: Luciana Silvestre Girelli, Marcela Ribeiro de Marins, Bruna C. F. Menezes Lemos e Sheila Maria Vidal.</p>
        <details class="book-credits">
          <summary>Créditos do livro</summary>
          <p>Autoria: Alexssandra da Penha Reis, Bruna Caroline Ferreira Menezes Lemos, Diego de Paula, Heloisa de Vilhena Queiroz Vilela Zacharias, Luciana Silvestre Girelli, Marcela Ribeiro de Marins, Paulo Henrique Ribeiro Lima, Roberta Natielly Pereira Victor e Sheila Maria Vidal.</p>
          <p>Edição de texto: Bruna Caroline Ferreira Menezes Lemos, Luciana Silvestre Girelli e Marcela Ribeiro de Marins. Revisão textual: Bruna Caroline Ferreira Menezes Lemos e Marcela Ribeiro de Marins.</p>
          <p>Identidade visual e projeto gráfico: Gustavo Binda. Foto de capa: Caio Fabricius.</p>
          <p>Fotografias do livro: Bruna Caroline Ferreira Menezes Lemos, Caio Fabricius, Diego de Paula, Luciana Silvestre Girelli, Paulo Henrique Ribeiro Lima, Stéfany Vithória de Oliveira Silva e acervos pessoais e institucionais.</p>
        </details>
        <a class="button button-dark" href={bookUrl}>Acessar o livro no repositório do Ifes <span aria-hidden="true">↗</span></a>
        <p class="small-note">Link externo para o download do livro em PDF.</p>
      </div>
    </div>
  </section>
</BaseLayout>
