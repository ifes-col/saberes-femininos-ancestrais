---
interface Props {
  label: string;
  heading: string;
}

const { label, heading } = Astro.props;
---
<dialog class="lightbox" aria-label={label} aria-describedby="lightbox-caption">
  <div class="lightbox-content">
    <div class="lightbox-header">
      <p>{heading}</p>
      <button class="lightbox-button lightbox-close" type="button" aria-label="Fechar visualizador" autofocus><span aria-hidden="true">×</span></button>
    </div>
    <div class="lightbox-stage">
      <button class="lightbox-button lightbox-previous" type="button" aria-label="Imagem anterior"><span aria-hidden="true">‹</span></button>
      <img class="lightbox-image" alt="" />
      <button class="lightbox-button lightbox-next" type="button" aria-label="Próxima imagem"><span aria-hidden="true">›</span></button>
    </div>
    <p class="lightbox-caption" id="lightbox-caption" aria-live="polite" aria-atomic="true"></p>
  </div>
</dialog>
<script>
  const dialog = document.querySelector('.lightbox');
  const image = document.querySelector('.lightbox-image');
  const caption = document.querySelector('.lightbox-caption');
  const previous = document.querySelector('.lightbox-previous');
  const next = document.querySelector('.lightbox-next');
  const close = document.querySelector('.lightbox-close');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox-item]'));

  if (dialog instanceof HTMLDialogElement && typeof dialog.showModal === 'function' &&
      image instanceof HTMLImageElement && caption && previous && next && close && links.length) {
    const viewerImage = image;
    const viewerCaption = caption;
    let current = 0;
    let opener: HTMLAnchorElement | undefined;

    function showImage(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current];
      const thumbnail = link.querySelector('img');
      if (!thumbnail) throw new Error('Imagem da galeria não encontrada.');
      viewerImage.src = link.href;
      viewerImage.alt = thumbnail.alt;
      viewerCaption.textContent = `Imagem ${current + 1} de ${links.length}. ${thumbnail.alt}`;
    }

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        opener = link;
        showImage(index);
        dialog.showModal();
        document.body.classList.add('lightbox-open');
        event.preventDefault();
      });
    });

    previous.addEventListener('click', () => showImage(current - 1));
    next.addEventListener('click', () => showImage(current + 1));
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        showImage(current + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('lightbox-open');
      opener?.focus();
    });
  }
</script>
